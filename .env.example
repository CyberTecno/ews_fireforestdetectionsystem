# ============================================================
#  EFWS — Environment Variables
#  cp .env.example .env  →  edit nilai di bawah  →  jangan commit .env ke git
# ============================================================

# ── Identitas perangkat ──────────────────────────────────────
EFWS_DEVICE_ID=DEV-JAM-TEST02
EFWS_DEVICE_TOKEN=test

# ── Mode operasi ─────────────────────────────────────────────
# "mock"     → testing tanpa hardware (nilai sensor disimulasi)
# "hardware" → akses GPIO/SPI/I2C + auto-detect SIM A7670E atau SIM7600
EFWS_RUN_MODE=mock

# ── REST API ──────────────────────────────────────────────────
# Endpoint aktual yang dipakai: EFWS_API_URL/sensors/telemetry
# Untuk prototyping: buka https://webhook.site, copy URL unik ke sini.
EFWS_API_URL=https://webhook.site/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
EFWS_API_KEY=

# ── GPS fallback (dipakai kalau SIM GPS tidak dapat fix) ─────
EFWS_LAT=-1.2654
EFWS_LON=116.8312
EFWS_GPS_TIMEOUT=90
EFWS_GPS_INTERVAL=300

# ── Timing ───────────────────────────────────────────────────
EFWS_READ_INTERVAL=5
# Setiap siklus baca, device LANGSUNG coba kirim ke API. Kalau gagal,
# masuk antrian offline dan device tidak spam retry — dia cuma cek
# sinyal ulang tiap EFWS_CONNECTIVITY_CHECK_SEC (default 120 = 2 menit).
EFWS_CONNECTIVITY_CHECK_SEC=120

# ── SIM (port auto-detect via sim_detector.py) ───────────────
# Biarkan kosong untuk auto-detect. Isi hanya jika ingin pin ke port tertentu.
# EFWS_SIM_PORT=/dev/ttyUSB2
EFWS_APN=internet

# ── smokeLevel (gabungan MQ-2 + MQ-135 → 0-100%) ────────────
# Formula: (mq2/MQ2_CRIT*W_MQ2 + mq135/MQ135_CRIT*W_MQ135) * 100
# Default: MQ-2 bobot 55%, MQ-135 bobot 45%, warning ≥60%, critical ≥70%
# EFWS_SMOKE_MQ2_CRIT=1000.0
# EFWS_SMOKE_MQ135_CRIT=1000.0
# EFWS_SMOKE_W_MQ2=0.55
# EFWS_SMOKE_W_MQ135=0.45
# EFWS_SMOKE_WARN=60.0
# EFWS_SMOKE_CRIT=70.0

# ── Battery — Modul Sensor Tegangan DC 0-25V ──────────────────
# Voltage sensor ditap di terminal Battery+ / Battery− langsung
# (BUKAN di output buck converter).
# EFWS_BATTERY_SENSOR_MAX_V=25.0   # max input modul sensor (V) — jangan diubah kecuali ganti modul
# EFWS_BATTERY_MAX_V=12.6          # tegangan baterai PENUH (LiFePO4: 14.4V, Li-ion: 12.6V)
# EFWS_BATTERY_MIN_V=9.0           # tegangan baterai KOSONG

# ── SPI / MCP3008 channel mapping ────────────────────────────
# EFWS_ADC_MQ2=0
# EFWS_ADC_MQ135=1
# EFWS_ADC_SOIL_SURFACE=2
# EFWS_ADC_SOIL_DEEP=3
# EFWS_ADC_FLAME_AO=4
# EFWS_ADC_BATTERY=5

# ── GPIO ─────────────────────────────────────────────────────
# EFWS_GPIO_FLAME=17
# EFWS_GPIO_RELAY=27
# EFWS_GPIO_LED=23

# ── I2C ──────────────────────────────────────────────────────
# EFWS_BME280_ADDR=0x76

# ── Database & logging ────────────────────────────────────────
# EFWS_DB_PATH=database/efws_data.db
# EFWS_LOG_PATH=logs/efws.log

# ── API internal ─────────────────────────────────────────────
# EFWS_VERIFY_SSL=true
# EFWS_ANEM_PORT=/dev/ttyUSB0
