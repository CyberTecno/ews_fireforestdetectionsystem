# ============================================================
#  EFWS — Environment Variables
#  cp .env.example .env  →  edit nilai di bawah  →  jangan commit .env ke git
# ============================================================

# ── Identitas perangkat ──────────────────────────────────────
EFWS_DEVICE_ID=DEV-JAM-TEST02
EFWS_DEVICE_TOKEN=test

# ── Mode operasi ─────────────────────────────────────────────
# "mock"     → testing tanpa hardware (nilai sensor disimulasi)
# "hardware" → akses GPIO/SPI/I2C + SIM7600 via /dev/ttyUSB2
EFWS_RUN_MODE=mock

# ── REST API ──────────────────────────────────────────────────
# 4 endpoint dipakai, semua di-derive dari EFWS_API_URL:
#   EFWS_API_URL/sensors/location       (endpoint 1, scheduled)
#   EFWS_API_URL/sensors/telemetry      (endpoint 2, scheduled, bawa 'config')
#   EFWS_API_URL/sensors/heartbeat      (endpoint 3, scheduled, bawa 'commands')
#   EFWS_API_URL/sensors/commands/ack   (endpoint 4, event-driven)
# Untuk prototyping: buka https://webhook.site, copy URL unik ke sini
# (endpoint 4 tidak akan pernah terpanggil dari webhook.site karena tidak
# pernah mengembalikan 'commands' -- pakai tools/mock_api_server.py kalau
# mau test command/reboot end-to-end).
EFWS_API_URL=https://webhook.site/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
EFWS_API_KEY=

# ── GPS (dibaca dari cache file, ditulis oleh ews_network_setup.sh) ────────────
# EFWS_LAT/EFWS_LON = fallback statis, DIPAKAI HANYA kalau cache GPS
# tidak ada atau fix=false (belum pernah dapat fix sama sekali).
EFWS_LAT=-6.2146
EFWS_LON=106.8208
# File cache GPS (ditulis script bash, dibaca main.py). Default: /tmp/ews_gps_cache.json
# EFWS_GPS_CACHE=/tmp/ews_gps_cache.json

# ── Timing ───────────────────────────────────────────────────
# Siklus CEK sensor -- selalu jalan tiap ini, murni evaluasi threshold
# (cepat, demi respons darurat). BUKAN berarti selalu kirim data.
EFWS_READ_INTERVAL=180

# Siklus KIRIM RUTIN saat kondisi NORMAL.
# CATATAN: variabel ini sudah TIDAK BERLAKU sejak arsitektur diubah ke
# 3 scheduler independen (Location/Telemetry/Heartbeat masing-masing di
# thread sendiri). Gunakan EFWS_TELEMETRY_INTERVAL_SEC (default 1800s = 30
# menit) dan EFWS_LOCATION_INTERVAL_SEC (default 1800s) sebagai gantinya.
# EFWS_ROUTINE_SEND_INTERVAL_SEC=360   ← OBSOLETE, jangan dipakai

# Retry offline queue -- berjalan di THREAD TERPISAH, independen dari
# EFWS_READ_INTERVAL, supaya tetap persis tiap 2 menit walau siklus baca
# sensor 3 menit.
EFWS_CONNECTIVITY_CHECK_SEC=120

# ── Command executor (endpoint 4: /sensors/commands/ack) ────
# Delay sebelum systemctl restart benar-benar dieksekusi setelah command
# "Reboot" diterima lewat heartbeat -- WAJIB > 0 supaya ACK sempat
# terkirim dulu sebelum proses ini mati karena restart-nya sendiri.
# EFWS_REBOOT_DELAY_SEC=5
#
# PENTING -- deployment requirement: user yang menjalankan efws.service
# (lihat User= di efws.service) harus bisa menjalankan:
#   sudo -n systemctl restart efws.service
# TANPA prompt password, atau command Reboot akan selalu gagal (FAILED).
# Tambahkan baris berikut ke /etc/sudoers.d/efws (ganti 'uwfadmin' sesuai
# User= di efws.service):
#   uwfadmin ALL=(root) NOPASSWD: /usr/bin/systemctl restart efws.service

# ── SIM7600 (port AT command) ───────────────────────────────────────
# /dev/ttyUSB2 = AT command port SIM7600 (Waveshare 4G HAT)
# Biarkan default kecuali port modem Anda berbeda.
# EFWS_SIM_PORT=/dev/ttyUSB2
# EFWS_SIM_BAUD=115200
EFWS_APN=internet

# ── smokeLevel (gabungan MQ-2 + MQ-135 → 0-100%) ────────────
# Formula: (mq2/MQ2_CRIT*W_MQ2 + mq135/MQ135_CRIT*W_MQ135) * 100
# Default: MQ-2 bobot 55%, MQ-135 bobot 45%, warning ≥60%, critical ≥70%
# EFWS_SMOKE_MQ2_CRIT=1000.0
# EFWS_SMOKE_MQ135_CRIT=1000.0
# EFWS_SMOKE_W_MQ2=0.55
# EFWS_SMOKE_W_MQ135=0.45
# EFWS_SMOKE_WARN=60.0
# EFWS_SMOKE_CRIT=70.0

# ── Battery — Modul Sensor Tegangan DC 0-25V ──────────────────
# Voltage sensor ditap di terminal Battery+ / Battery− langsung
# (BUKAN di output buck converter).
# EFWS_BATTERY_SENSOR_MAX_V=25.0   # max input modul sensor (V) — jangan diubah kecuali ganti modul
# EFWS_BATTERY_MAX_V=12.6          # tegangan baterai PENUH (LiFePO4: 14.4V, Li-ion: 12.6V)
# EFWS_BATTERY_MIN_V=9.0           # tegangan baterai KOSONG

# ── SPI / MCP3008 channel mapping ────────────────────────────
# EFWS_ADC_MQ2=0
# EFWS_ADC_MQ135=1
# EFWS_ADC_SOIL_SURFACE=2
# EFWS_ADC_SOIL_DEEP=3
# EFWS_ADC_PRESSURE=4
# EFWS_ADC_BATTERY=5
# EFWS_ADC_FLAME_AO -- lihat bagian "Flame Sensor" di bawah (channel 6)
# CH7 sengaja kosong (spare)

# ── GPIO ─────────────────────────────────────────────────────
# EFWS_GPIO_FLAME=17
# EFWS_GPIO_RELAY=27
# EFWS_GPIO_LED=23

# ── I2C ──────────────────────────────────────────────────────
# EFWS_BME280_ADDR=0x76

# ── Database & logging ────────────────────────────────────────
# EFWS_DB_PATH=database/efws_data.db
# EFWS_LOG_PATH=logs/efws.log

# ── API internal ─────────────────────────────────────────────
# EFWS_VERIFY_SSL=true
# EFWS_ANEM_PORT=/dev/ttyUSB0

# ── Wind Direction (UART GPIO14/15, pin 8/10) ───────────────────
# EFWS_WIND_DIR_PORT=/dev/serial0
# EFWS_WIND_DIR_BAUD=9600
# EFWS_WIND_DIR_TIMEOUT=1.0

# ── Flame Sensor (AO analog via MCP3008 CH6) ─────────────────────────────
# EFWS_ADC_FLAME_AO=6
# EFWS_FLAME_AO_THRESHOLD_V=1.65   # PERKIRAAN AWAL, WAJIB dikalibrasi di lapangan -- lihat sensors/flame.py

# ── Battery voltage sensor (rasio pembagi modul, lihat settings.py) ─────
# EFWS_BATTERY_SENSOR_MAX_V=16.5
