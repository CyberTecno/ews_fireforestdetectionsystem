# ============================================================
#  EFWS — Environment Variables
#  cp .env.example .env → edit values ​​below → do not commit .env to git
# ============================================================

# ── Device identity ──────────────────────────────────────
EFWS_DEVICE_ID=DEV-JAM-TEST02
EFWS_DEVICE_TOKEN=test

# ── Mode operasi ─────────────────────────────────────────────
# "mock" → testing without hardware (simulated sensor values)
# "hardware" → akses GPIO/SPI/I2C + SIM7600 via /dev/ttyUSB2
EFWS_RUN_MODE=mock

# ── REST API ───────────────────────── ─────────────────────────
# 4 endpoints are used, all derived from EFWS_API_URL:
#   EFWS_API_URL/sensors/location       (endpoint 1, scheduled)
#   EFWS_API_URL/sensors/telemetry      (endpoint 2, scheduled, bawa 'config')
#   EFWS_API_URL/sensors/heartbeat      (endpoint 3, scheduled, bawa 'commands')
#   EFWS_API_URL/sensors/commands/ack   (endpoint 4, event-driven)
# For prototyping: go to https://webhook.site, copy unique URL here
# (endpoint 4 will never be called from webhook.site because it doesn't
# never returns 'commands' -- use tools/mock_api_server.py if
# mau test command/reboot end-to-end).
EFWS_API_URL=https://webhook.site/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
EFWS_API_KEY=

# ── GPS (read from file cache, written by ews_network_setup.sh) ────────────
# EFWS_LAT/EFWS_LON = static fallback, USED ONLY if cache GPS
# none or fix=false (never been able to fix it at all).
EFWS_LAT=-6.2146
EFWS_LON=106.8208
# Cache file GPS (written bash script, read main.py). Default: /tmp/ews_gps_cache.json
# EFWS_GPS_CACHE=/tmp/ews_gps_cache.json

# ── Timing ───────────────────────────────────────────────────
# Cycle CEK sensor -- always runs every time, purely threshold evaluation
# (fast, for emergency response). NOT means always send data.
EFWS_READ_INTERVAL=180

# Cycle SEND ROUTINE when state is NORMAL.
# NOTE: this variable has been VOID since the architecture was changed to
# 3 independent schedulers (Location/Telemetry/Heartbeat each in
# own thread). Use EFWS_TELEMETRY_INTERVAL_SEC (default 1800s = 30
# minutes) and EFWS_LOCATION_INTERVAL_SEC (default 1800s) instead.
# EFWS_ROUTINE_SEND_INTERVAL_SEC=360 ← OBSOLETE, do not use

# Retry offline queue -- runs on SEPARATE THREAD, independent of
# EFWS_READ_INTERVAL, so that it stays exactly every 2 minutes even though the read cycle
# sensor 3 minutes.
EFWS_CONNECTIVITY_CHECK_SEC=120

# ── Command executor (endpoint 4: /sensors/commands/ack) ────
# Delay before systemctl restart is actually executed after the command
# "Reboot" received via heartbeat -- MANDATORY > 0 so ACK can
# sent first before this process dies due to restarting itself.
# EFWS_REBOOT_DELAY_SEC=5
#
# IMPORTANT -- deployment requirement: user running efws.service
# (see User= in efws.service) should be able to run:
#   sudo -n systemctl restart efws.service
# NO password prompt, or Reboot command will always fail (FAILED).
# Add the following line to /etc/sudoers.d/efws (replace 'uwfadmin' accordingly
# User= in efws.service):
#   uwfadmin ALL=(root) NOPASSWD: /usr/bin/systemctl restart efws.service

# ── SIM7600 (port AT command) ───────────────────────────────────────
# /dev/ttyUSB2 = AT command port SIM7600 (Waveshare 4G HAT)
# Leave the default unless your modem port is different.
# EFWS_SIM_PORT=/dev/ttyUSB2
# EFWS_SIM_BAUD=115200
EFWS_APN=internet

# ── smokeLevel (gabungan MQ-2 + MQ-135 → 0-100%) ────────────
# Formula: (mq2/MQ2_CRIT*W_MQ2 + mq135/MQ135_CRIT*W_MQ135) * 100
# Default: MQ-2 bobot 55%, MQ-135 bobot 45%, warning ≥60%, critical ≥70%
# EFWS_SMOKE_MQ2_CRIT=1000.0
# EFWS_SMOKE_MQ135_CRIT=1000.0
# EFWS_SMOKE_W_MQ2=0.55
# EFWS_SMOKE_W_MQ135=0.45
# EFWS_SMOKE_WARN=60.0
# EFWS_SMOKE_CRIT=70.0

# ── Battery — Voltage Sensor Module DC 0-25V ──────────────────
# The voltage sensor is tapped on the Battery+ / Battery− terminal directly
# (NOT at buck converter output).
# EFWS_BATTERY_SENSOR_MAX_V=25.0 # max sensor module input (V) — do not change unless replace module
# EFWS_BATTERY_MAX_V=12.6# battery voltage FULL (LiFePO4: 14.4V, Li-ion: 12.6V)
# EFWS_BATTERY_MIN_V=9.0 # battery voltage EMPTY

# ── SPI / MCP3008 channel mapping ────────────────────────────
# EFWS_ADC_MQ2=0
# EFWS_ADC_MQ135=1
# EFWS_ADC_SOIL_SURFACE=2
# EFWS_ADC_SOIL_DEEP=3
# EFWS_ADC_PRESSURE=4
# EFWS_ADC_BATTERY=5
# EFWS_ADC_FLAME_AO -- see "Flame Sensor" section below (channel 6)
# CH7 intentionally empty (spare)

# ── GPIO ─────────────────────────────────────────────────────
# EFWS_GPIO_FLAME=17
# EFWS_GPIO_RELAY=27
# EFWS_GPIO_LED=23

# ── I2C ──────────────────────────────────────────────────────
# EFWS_BME280_ADDR=0x76

# ── Database & logging ────────────────────────────────────────
# EFWS_DB_PATH=database/efws_data.db
# EFWS_LOG_PATH=logs/efws.log

# ── API internal ────────────────────── ───────────────────────
# EFWS_VERIFY_SSL=true
# EFWS_ANEM_PORT=/dev/ttyUSB0

# ── Wind Direction (UART GPIO14/15, pin 8/10) ───────────────────
# EFWS_WIND_DIR_PORT=/dev/serial0
# EFWS_WIND_DIR_BAUD=9600
# EFWS_WIND_DIR_TIMEOUT=1.0

# ── Flame Sensor (AO analog via MCP3008 CH6) ─────────────────────────────
# EFWS_ADC_FLAME_AO=6
# EFWS_FLAME_AO_THRESHOLD_V=1.65 # INITIAL ESTIMATE, MANDATORY field calibrated -- see sensors/flame.py

# ── Battery voltage sensor (module divider ratio, see settings.py) ─────
# EFWS_BATTERY_SENSOR_MAX_V=16.5
