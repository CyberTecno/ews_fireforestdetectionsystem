# ============================================================
#  EFWS — Environment Variables Template
#  Salin file ini:  cp .env.example .env
#  Lalu isi nilai yang sesuai. JANGAN commit file .env ke git!
# ============================================================

# ── Identitas perangkat ──────────────────────────────────────
EFWS_DEVICE_ID=efws-001

# ── Mode operasi ─────────────────────────────────────────────
# "mock"     → testing tanpa hardware
# "hardware" → akses GPIO/SPI/I2C + GPS A7670E/SIM7670E nyata
EFWS_RUN_MODE=mock

# ── REST API (WAJIB diisi) ────────────────────────────────────
# Untuk testing/prototyping: buat URL unik gratis di https://webhook.site
# lalu copy URL "Your unique URL" ke sini. Untuk production: ganti ke
# URL server backend Anda sendiri.
EFWS_API_URL=https://webhook.site/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Bearer token (kosongkan jika API tidak pakai auth - webhook.site tidak butuh ini)
EFWS_API_KEY=

# ── GPS (A7670E / SIM7670E) ───────────────────────────────────
# Koordinat lat/lon diambil OTOMATIS dari GNSS modul A7670E/SIM7670E.
# Isi ini hanya sebagai FALLBACK jika GPS tidak dapat fix.
EFWS_LAT=-1.2654
EFWS_LON=116.8312
# Timeout tunggu GPS fix saat startup (detik, default 90)
EFWS_GPS_TIMEOUT=90
# Seberapa sering refresh koordinat GPS (detik, default 300 = 5 menit)
EFWS_GPS_INTERVAL=300

# ── Timing ───────────────────────────────────────────────────
EFWS_READ_INTERVAL=5          # baca sensor tiap N detik
EFWS_PUBLISH_INTERVAL=10      # kirim ke API tiap N detik

# ── Database & logging ────────────────────────────────────────
# Biarkan kosong untuk pakai path default (database/efws_data.db, logs/efws.log)
# EFWS_DB_PATH=/home/pi/efws/efws/database/efws_data.db
# EFWS_LOG_PATH=/home/pi/efws/efws/logs/efws.log

# ── Jaringan ─────────────────────────────────────────────────
EFWS_APN=internet             # APN SIM card (Telkomsel=internet, XL=internet, dll)
EFWS_VERIFY_SSL=true

# ── Hardware: port serial (hanya saat RUN_MODE=hardware) ─────
EFWS_ANEM_PORT=/dev/ttyUSB0   # anemometer RS485 (lewat USB-RS485 converter)
EFWS_SIM_PORT=/dev/ttyUSB2    # A7670E/SIM7670E AT command port (cek dengan: ls /dev/ttyUSB*)

# ── Hardware: SPI / MCP3008 (ubah hanya jika wiring berbeda) ─
# EFWS_SPI_BUS=0
# EFWS_SPI_DEVICE=0
# EFWS_SPI_SPEED=1350000
# EFWS_MCP3008_VREF=3.3
# EFWS_ADC_MQ2=0
# EFWS_ADC_MQ135=1
# EFWS_ADC_SOIL=2
# EFWS_ADC_FLAME_AO=3

# ── Hardware: GPIO/I2C (ubah hanya jika wiring berbeda) ──────
# EFWS_GPIO_FLAME=17
# EFWS_GPIO_RELAY=27
# EFWS_GPIO_LED=23
# EFWS_BME280_ADDR=0x76
