[Unit]
Description=Early Fire Warning System (EFWS)
After=network-online.target gsm-connect.service
Requires=gsm-connect.service

[Service]
# ── Ganti path sesuai lokasi install di Raspberry Pi ──
# Struktur project ini FLAT: main.py langsung di root project
# (sejajar dengan venv/, .env, scripts/, logs/, database/)
WorkingDirectory=/home/pi/efws
ExecStart=/home/pi/efws/venv/bin/python main.py

# ── Environment ───────────────────────────────────────
# systemd membaca file .env LANGSUNG - satu-satunya sumber kebenaran,
# sama seperti saat dijalankan manual lewat `python main.py`.
# Tanda "-" di depan path berarti tidak gagal kalau file belum ada.
EnvironmentFile=-/home/pi/efws/.env

# ── Restart policy ────────────────────────────────────
Restart=always
RestartSec=10
StartLimitIntervalSec=120
StartLimitBurst=5

# ── Output ke journald (journalctl -u efws -f) ────────
StandardOutput=journal
StandardError=journal
SyslogIdentifier=efws

# ── User (jalankan sebagai user biasa, BUKAN root) ────
# Ganti "pi" sesuai username Raspberry Pi Anda. User ini WAJIB ada di
# grup gpio, spi, i2c, dialout agar bisa akses GPIO/SPI/I2C/serial port
# tanpa sudo (lihat docs/DEPLOYMENT.md langkah persiapan user).
User=pi
Group=pi

[Install]
WantedBy=multi-user.target
