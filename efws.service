[Unit]
Description=Early Fire Warning System (EFWS)
After=network-online.target gsm-connect.service
Requires=gsm-connect.service

[Service]
# ── Change the path according to the installation location on the Raspberry Pi ──
# The structure of this project is FLAT: main.py directly in the root of the project
# (parallel to venv/, .env, scripts/, logs/, database/)
WorkingDirectory=/home/uwfadmin/ews
ExecStart=/home/uwfadmin/ews/venv/bin/python main.py

# ── Environment ───────────────────────────────────────
# systemd reads .env files DIRECTLY - the only source of truth,
# the same as when run manually via `python main.py`.
# The "-" sign in front of the path means it won't fail if the file doesn't exist yet.
EnvironmentFile=-/home/uwfadmin/ews/.env

# ── Restart policy ────────────────────────────────────
Restart=always
RestartSec=10
StartLimitIntervalSec=120
StartLimitBurst=5

# ── Output to journald (journalctl -u efws -f) ────────
StandardOutput=journal
StandardError=journal
SyslogIdentifier=efws

# ── User (run as normal user, NOT root) ────
# Replace "pi" with your Raspberry Pi username. This user MUST be on
# gpio, spi, i2c, dialout group to access GPIO/SPI/I2C/serial port
# without sudo (see docs/DEPLOYMENT.md user setup steps).
User=uwfadmin
Group=uwfadmin

[Install]
WantedBy=multi-user.target
